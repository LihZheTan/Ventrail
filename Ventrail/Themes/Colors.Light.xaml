<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light colours: same keys as Colors.Dark.xaml (see the note there). Soft greys, white cards. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#F3F3F5"/>
    <SolidColorBrush x:Key="PanelBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RailBrush"        Color="#EBEBEE"/>
    <SolidColorBrush x:Key="CardBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush"   Color="#EEEEF1"/>
    <SolidColorBrush x:Key="InputBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush"        Color="#DCDCE2"/>

    <!-- Text and accents -->
    <SolidColorBrush x:Key="TextBrush"        Color="#18181B"/>
    <SolidColorBrush x:Key="SubtleTextBrush"  Color="#62626C"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#0A66D8"/>
    <SolidColorBrush x:Key="OnAccentBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AddedBrush"       Color="#1A7F37"/>
    <SolidColorBrush x:Key="ModifiedBrush"    Color="#9A6700"/>
    <SolidColorBrush x:Key="DeletedBrush"     Color="#CF222E"/>
    <SolidColorBrush x:Key="MergeBrush"       Color="#8250DF"/>
    <SolidColorBrush x:Key="TimelineBrush"    Color="#D4D4DA"/>

    <!-- Faint tints -->
    <SolidColorBrush x:Key="AddedTintBrush"    Color="#1F1A7F37"/>
    <SolidColorBrush x:Key="ModifiedTintBrush" Color="#1F9A6700"/>
    <SolidColorBrush x:Key="DeletedTintBrush"  Color="#1FCF222E"/>
    <SolidColorBrush x:Key="AccentTintBrush"   Color="#1A0A66D8"/>
    <SolidColorBrush x:Key="SelectedRowBrush"  Color="#260A66D8"/>

    <!-- App sidebar -->
    <SolidColorBrush x:Key="SidebarBrush"      Color="#E6E6EA"/>
    <SolidColorBrush x:Key="NavHoverBrush"     Color="#DADADF"/>
    <SolidColorBrush x:Key="NavSelectedBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavTextBrush"      Color="#18181B"/>
    <SolidColorBrush x:Key="NavSubtleBrush"    Color="#62626C"/>

    <!-- Welcome banner gradient -->
    <Color x:Key="HeroStartColor">#CFE2FF</Color>
    <Color x:Key="HeroEndColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BackdropBrush" Color="#6618181B"/>

    <Color x:Key="AccentColor">#0A66D8</Color>
    <Color x:Key="ShadowColor">#8C8C96</Color>
</ResourceDictionary>
