<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Ventrail.Converters">

    <!--
        Ventrail styles (redesign: a GitHub Desktop-style layout with light and dark themes).
        Colours come from Colors.Dark.xaml / Colors.Light.xaml, merged by ThemeManager, and are
        always used through {DynamicResource ...} so switching themes repaints the whole app.
    -->

    <!-- ===================== Fonts ===================== -->
    <!-- Windows 11's Segoe UI Variable (Windows 10 falls back to Segoe UI) and Cascadia Mono for code. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <!-- Built-in Windows icon font (Windows 11 name first, Windows 10 fallback). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== Converters ===================== -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    <conv:EnumToVisibilityConverter x:Key="EnumToVis"/>
    <conv:EnumToBoolConverter x:Key="EnumToBool"/>
    <conv:WidthBelowConverter x:Key="WidthBelow"/>

    <!-- ===================== Text ===================== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="PaneTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Colour of the status word ("Added", "Modified", ...). -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Added">
                <Setter Property="Foreground" Value="{DynamicResource AddedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Deleted">
                <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Conflict">
                <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Renamed">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Coloured dot (files inside a version). -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource ModifiedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Added">
                <Setter Property="Fill" Value="{DynamicResource AddedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Deleted">
                <Setter Property="Fill" Value="{DynamicResource DeletedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Conflict">
                <Setter Property="Fill" Value="{DynamicResource DeletedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Renamed">
                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Small square status mark at the end of a changed-file row (+ added, • modified, − deleted). -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModifiedBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ModifiedTintBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Added">
                <Setter Property="BorderBrush" Value="{DynamicResource AddedBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AddedTintBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Deleted">
                <Setter Property="BorderBrush" Value="{DynamicResource DeletedBrush}"/>
                <Setter Property="Background" Value="{DynamicResource DeletedTintBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Conflict">
                <Setter Property="BorderBrush" Value="{DynamicResource DeletedBrush}"/>
                <Setter Property="Background" Value="{DynamicResource DeletedTintBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Renamed">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Text" Value="&#xF127;"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Added">
                <Setter Property="Text" Value="&#xE710;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Deleted">
                <Setter Property="Text" Value="&#xE738;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Conflict">
                <Setter Property="Text" Value="&#xE7BA;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding TrackStatus}" Value="Renamed">
                <Setter Property="Text" Value="&#xE72A;"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Containers ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Highlighted card (AI suggestions, Share panel): accent outline on a faint accent tint. -->
    <Style x:Key="GlowCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>

    <!-- Small rounded label, e.g. "Latest", "Heavy", "Online". -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main action button (blue). -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Secondary button with an outline. -->
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>

    <!-- Button for actions that throw something away (Discard). -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}"/>
    </Style>

    <!-- Borderless icon or text button (inside lists, headers). -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
    </Style>

    <!-- ===================== Toolbar (GitHub Desktop style) ===================== -->
    <!-- A toolbar segment: small grey caption above a bold value, e.g. "Current repository / Thesis". -->
    <Style x:Key="ToolbarButtonBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource ToolbarTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource ToolbarLineBrush}" BorderThickness="0,0,1,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}"/>
    <Style x:Key="ToolbarToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolbarCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolbarSubtleBrush}"/>
    </Style>
    <Style x:Key="ToolbarValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolbarTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ToolbarIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolbarSubtleBrush}"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- "Changes | History" tabs at the top of the sidebar: underline on the selected one. -->
    <Style x:Key="SidebarTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="12,0"
                                Background="{DynamicResource AccentBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Menu bar ===================== -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource RailBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource LineBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Width="22" Style="{StaticResource Icon}" FontSize="12"
                                       Text="&#xE73E;" Foreground="{DynamicResource AccentBrush}" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Margin="32,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleTextBrush}"/>
                            <TextBlock x:Name="Arrow" Grid.Column="3" Style="{StaticResource Icon}" FontSize="10"
                                       Text="&#xE76C;" Margin="12,0,0,0" Foreground="{DynamicResource SubtleTextBrush}"
                                       Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,10,10" MinWidth="200">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="Black"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/>
                            <Setter TargetName="Bd" Property="Padding" Value="10,4"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Bd" Property="Padding" Value="10,4"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Progress ===================== -->
    <!-- Progress bar for the commit screen. -->
    <Style x:Key="GlowProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="5" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===================== Inputs ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placeholder text over an empty TextBox: put it in the same Grid cell, with Tag = the TextBox. -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="Margin" Value="10,6,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Rounded checkbox that fills with the accent colour and a white tick when checked. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{DynamicResource SubtleTextBrush}" Background="Transparent"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Scrollbars (slim) ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource LineBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SubtleTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SubtleTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" Margin="1,2"/>
            </Track.Thumb>
        </Track>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="False">
            <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" Margin="2,1"/>
            </Track.Thumb>
        </Track>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Lists ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Flat list rows with a thin divider; the selected row is tinted with an accent bar on the left. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tighter rows for small lists (e.g. files inside a version). -->
    <Style x:Key="CompactListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="12,5"/>
    </Style>

    <!-- History rows: the timeline line runs through the row, so no padding at the left. -->
    <Style x:Key="TimelineItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="0,0,12,0"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="2,3"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
    </Style>

    <!-- ===================== Diff (Week 7) ===================== -->
    <!-- Line-by-line comparison, used beside the changed files and in the full-size viewer. -->
    <DataTemplate x:Key="DiffTemplate">
        <Grid>
            <!-- Binary / too large / no changes -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="20"
                        Visibility="{Binding CanShowLines, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource SubtleText}" TextAlignment="Center"/>
            </StackPanel>

            <!-- Virtualised so long files stay fast -->
            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2"
                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                          Visibility="{Binding CanShowLines, Converter={StaticResource BoolToVis}}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OldLineNumber}" Width="44" TextAlignment="Right"
                                           Foreground="{DynamicResource SubtleTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                <TextBlock Text="{Binding NewLineNumber}" Width="44" TextAlignment="Right"
                                           Foreground="{DynamicResource SubtleTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                <TextBlock x:Name="SignText" Text="{Binding Sign}" Width="24" TextAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                <TextBlock x:Name="LineText" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                           Margin="0,0,20,0"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AddedTintBrush}"/>
                                <Setter TargetName="SignText" Property="Foreground" Value="{DynamicResource AddedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource DeletedTintBrush}"/>
                                <Setter TargetName="SignText" Property="Foreground" Value="{DynamicResource DeletedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                                <Setter TargetName="Row" Property="Padding" Value="0,4"/>
                                <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="LineText" Property="FontFamily" Value="{StaticResource UiFont}"/>
                                <Setter TargetName="LineText" Property="FontSize" Value="12"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
