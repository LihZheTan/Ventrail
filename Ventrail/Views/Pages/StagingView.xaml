<UserControl x:Class="Ventrail.Views.Pages.StagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ventrail.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainDashboardViewModel}"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!--
        Main dashboard, 3 panes (proposal section 3.3.2 Information Architecture):
        LEFT   = navigation context (workspace tree + branch)
        CENTRE = staging area (the main action)
        RIGHT  = file inspector + AI insights
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT: workspace ===================== -->
        <Border Grid.Column="0" Width="250" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,18,10,14">
                <Border.Style>
                    <!-- Responsive (Week 4): hide this pane when the page is narrower than 940px -->
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=940}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <DockPanel>
                <!-- Branch (bottom) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,10,0,14"/>
                    <TextBlock Text="BRANCHES" Style="{StaticResource PaneTitle}"/>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding BranchName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Only the current branch is shown for now." Style="{StaticResource SubtleText}"
                               FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Workspace tree (top) -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip="Refresh"
                            Padding="6,3" Background="Transparent" BorderThickness="0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource PaneTitle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentDirectory}"/>
                    </StackPanel>
                </DockPanel>

                <TreeView ItemsSource="{Binding WorkspaceTree}" Margin="-4,4,0,0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="13"
                                           Foreground="{StaticResource ModifiedBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding RelativePath}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ===================== CENTRE: staging area ===================== -->
        <DockPanel Grid.Column="1" Margin="26,22,26,20">

            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Stage All" Style="{StaticResource AccentButton}"
                        Command="{Binding StageAllCommand}" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Staging Area" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,0">
                        <Run Text="{Binding Changes.Count, Mode=OneWay}"/> changed ·
                        <Run Text="{Binding StagedCount, Mode=OneWay}"/> ticked for the next version
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Commit box (bottom) -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid>
                    <TextBox x:Name="CommitBox" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                             Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto">
                        <TextBox.InputBindings>
                            <!-- Ctrl+Enter saves the version without reaching for the mouse -->
                            <KeyBinding Gesture="Ctrl+Return" Command="{Binding CommitCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <!-- Placeholder text, shown while the box is empty -->
                    <TextBlock Text="Describe what changed in this version...  (Ctrl+Enter to commit)" IsHitTestVisible="False"
                               Foreground="{StaticResource SubtleTextBrush}" Margin="11,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CommitBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <DockPanel Margin="0,10,0,10">
                    <TextBlock Text="Author" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding AuthorName}" Width="200" HorizontalAlignment="Left"/>
                </DockPanel>
                <Button Content="Commit Changes" Style="{StaticResource AccentButton}" Padding="0,11" FontSize="14"
                        Command="{Binding CommitCommand}"
                        ToolTip="Save the ticked files as a new version (Ctrl+Enter)"/>
            </StackPanel>

            <!-- Changed files -->
            <Grid>
                <TextBlock Text="No changes. Everything in this folder is saved."
                           Style="{StaticResource SubtleText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasChanges, Converter={StaticResource InverseBoolToVis}}"/>

                <ListBox ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedFile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Background="Transparent">
                                <!-- Week 7: double-click a file to see what changed in it -->
                                <DockPanel.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.ViewChangesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </DockPanel.InputBindings>
                                <!-- Status badge: + added, pencil modified, - deleted -->
                                <Border Style="{StaticResource StatusBadge}" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource StatusGlyph}"/>
                                </Border>
                                <!-- File type icon -->
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding TypeGlyph}" FontSize="16"
                                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,10,0"/>
                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                                          IsChecked="{Binding IsStaged, Mode=TwoWay}"
                                          Command="{Binding DataContext.ToggleStageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"
                                          ToolTip="Include in the next version"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TrackStatus}" Style="{StaticResource StatusText}"
                                           Width="64" TextAlignment="Right"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DisplaySize}" Style="{StaticResource SubtleText}"
                                           FontSize="12" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                <!-- Week 8: ML.NET "Heavy" verdict (Week 6 "Large" size rule if the model is unavailable) -->
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="8,2" Margin="8,0,0,0"
                                        Background="{StaticResource ModifiedTintBrush}"
                                        Visibility="{Binding HasStorageBadge, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding StorageBadgeTip}">
                                    <TextBlock Text="{Binding StorageBadge}" FontSize="11" Foreground="{StaticResource ModifiedBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource SubtleText}" FontSize="11"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- ===================== RIGHT: inspector ===================== -->
        <Border Grid.Column="2" Width="300" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,22,20,20">
                <Border.Style>
                    <!-- Responsive (Week 4): hide this pane when the page is narrower than 760px -->
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=760}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <StackPanel>
                <TextBlock Text="File Inspector" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Text="Select a file in the staging area to inspect it."
                           Style="{StaticResource SubtleText}" Margin="0,0,0,16"
                           Visibility="{Binding HasSelectedFile, Converter={StaticResource InverseBoolToVis}}"/>

                <Grid Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="File name" Style="{StaticResource SubtleText}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFile.FileName}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Text="Location" Style="{StaticResource SubtleText}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFile.FilePath}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource SubtleText}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFile.DisplaySize}"/>

                    <TextBlock Grid.Row="3" Text="Type" Style="{StaticResource SubtleText}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFile.FileType}"/>

                    <TextBlock Grid.Row="4" Text="Status" Style="{StaticResource SubtleText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" DataContext="{Binding SelectedFile}"
                               Text="{Binding TrackStatus}" Style="{StaticResource StatusText}"
                               HorizontalAlignment="Left"/>
                </Grid>

                <!-- Week 7: compare with / go back to the last saved version -->
                <UniformGrid Columns="2" Margin="0,0,0,18"
                             Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding ViewChangesCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,5,0"
                            Padding="8,7" ToolTip="Compare with the last saved version (or double-click the file)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A1;" Margin="0,0,6,0"/>
                            <TextBlock Text="View changes"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DiscardSelectedFileCommand}" Margin="5,0,0,0" Padding="8,7"
                            Foreground="{StaticResource DeletedBrush}"
                            ToolTip="Go back to the last saved version. The current copy goes to the Recycle Bin.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,6,0"/>
                            <TextBlock Text="Discard"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- AI card -->
                <Border Style="{StaticResource GlowCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="AI Recommendations" FontWeight="SemiBold"/>
                        </StackPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" Foreground="{StaticResource ModifiedBrush}"
                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SubtleText}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
