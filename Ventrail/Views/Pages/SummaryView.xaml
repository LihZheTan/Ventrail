<UserControl x:Class="Ventrail.Views.Pages.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ventrail.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainDashboardViewModel}"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!-- Session Summary (proposal Fig 3.7 + mockup): shown from the Exit button. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Margin="24,30,24,24" MaxWidth="760">

            <!-- Title -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                <Border Width="34" Height="34" CornerRadius="17" BorderThickness="2"
                        BorderBrush="{StaticResource SubtleTextBrush}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </Border>
                <TextBlock Text="Session Summary" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Stat cards -->
            <UniformGrid Columns="4" Margin="0,0,0,30">
                <UniformGrid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="Padding" Value="12,16"/>
                        <Setter Property="Margin" Value="6,0"/>
                    </Style>
                    <Style x:Key="StatNumber" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="28"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,2,0,0"/>
                    </Style>
                </UniformGrid.Resources>

                <Border BorderBrush="{StaticResource AccentBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SessionCommits}"/>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Versions saved"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource AddedBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SessionFilesSaved}"/>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Files saved"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource MergeBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SessionTransfers}"/>
                        <TextBlock Style="{StaticResource StatLabel}" Text="P2P transfers"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource ModifiedBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SessionSharedDisplay}"/>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Shared"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Activity log -->
            <TextBlock Text="Session Activity Log" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,12"/>
            <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                <Grid>
                    <TextBlock Text="Nothing has happened yet in this session." Style="{StaticResource SubtleText}"
                               Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Top" Margin="0,6,12,0"/>
                                    <TextBlock Text="{Binding DisplayTime}" Style="{StaticResource SubtleText}"
                                               Width="44" FontFamily="Consolas" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,8">
                <Button Content="Continue Workflow" Style="{StaticResource AccentButton}" Width="190" Padding="0,10"
                        Margin="0,0,14,0" Command="{Binding ContinueWorkflowCommand}"/>
                <Button Content="Exit Application" Width="190" Padding="0,10"
                        Command="{Binding ExitApplicationCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="All data saved locally" Style="{StaticResource SubtleText}" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
