<UserControl x:Class="Ventrail.Views.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ventrail.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainDashboardViewModel}"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!-- Welcome screen (proposal Fig: launch screen). -->
    <Grid>
        <TextBlock Text="v0.4 · CP2 Week 4" Style="{StaticResource SubtleText}" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,12"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">

            <!-- Logo: a glowing "V" -->
            <TextBlock Text="V" FontSize="88" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,-6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Ventrail" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="AI-Enhanced Local Version Control" Style="{StaticResource SubtleText}"
                       FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,28"/>

            <!-- Already tracking a folder? Offer a way back in. -->
            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,0,0,12"
                    Padding="22,9" Command="{Binding NavigateToStagingCommand}"
                    Visibility="{Binding HasRepo, Converter={StaticResource BoolToVis}}">
                <TextBlock>
                    <Run Text="Continue with"/>
                    <Run Text="{Binding RepoName, Mode=OneWay}"/>
                </TextBlock>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}" Content="Open Repository" Width="170" Padding="0,9"
                        Margin="0,0,12,0" Command="{Binding OpenFolderCommand}"
                        ToolTip="Pick a folder that Ventrail already tracks, or any folder to start tracking"/>
                <Button Style="{StaticResource AccentButton}" Content="Create New Repository" Width="190" Padding="0,9"
                        Command="{Binding OpenFolderCommand}"
                        ToolTip="Pick or create (with 'New folder') an empty folder to start tracking"/>
            </StackPanel>

            <TextBlock Text="Recent Repositories" FontWeight="SemiBold" Margin="0,36,0,8"/>

            <Border Style="{StaticResource Card}" Padding="14,12"
                    Visibility="{Binding HasRecentRepositories, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource SubtleTextBrush}"
                               Margin="0,0,10,0"/>
                    <TextBlock Style="{StaticResource SubtleText}" Text="Folders you open will be listed here."/>
                </StackPanel>
            </Border>

            <!-- Each recent folder is a button: one click reopens it (Week 4) -->
            <ItemsControl ItemsSource="{Binding RecentRepositories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="10,7" Margin="0,0,0,2"
                                ToolTip="Open this folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource ModifiedBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
