<UserControl x:Class="Ventrail.Views.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ventrail.ViewModels"
             xmlns:conv="clr-namespace:Ventrail.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainDashboardViewModel}"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!--
        Home page: a hero banner, then
        the ways to begin on the left and recent repositories on the right.
    -->
    <UserControl.Resources>
        <conv:FolderNameConverter x:Key="FolderName"/>

        <!-- A big option row: icon, title, one-line explanation -->
        <Style x:Key="StartOption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1040" Margin="36,32,36,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== Hero banner ===================== -->
            <Border Grid.ColumnSpan="3" CornerRadius="16" Padding="32,28" Margin="0,0,0,28"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource HeroStartColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource HeroEndColor}" Offset="0.85"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Image DockPanel.Dock="Right" Source="/Assets/Ventrail.png" Width="112" Height="112" VerticalAlignment="Center"
                           Margin="24,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Let's get started!" Style="{StaticResource PageTitle}" FontSize="34"/>
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="15" Margin="0,8,0,20" MaxWidth="560" HorizontalAlignment="Left">
                            Ventrail keeps every version of your work, on your own computer, and sniffs out what changed.
                            Pick a folder to begin.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <!-- Already tracking a folder? Offer a way back in. -->
                            <Button Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="22,10" FontSize="14"
                                    Command="{Binding NavigateToStagingCommand}"
                                    Visibility="{Binding HasRepo, Converter={StaticResource BoolToVis}}">
                                <TextBlock>
                                    <Run Text="Continue with"/>
                                    <Run Text="{Binding RepoName, Mode=OneWay}"/>
                                </TextBlock>
                            </Button>
                            <Button Content="Open a folder" Padding="22,10" FontSize="14" Command="{Binding OpenFolderCommand}"
                                    ToolTip="Pick a folder to track (Ctrl+O)"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== Start ===================== -->
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Get started" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                <Button Style="{StaticResource StartOption}" Command="{Binding OpenFolderCommand}"
                        ToolTip="Pick or create (with 'New folder') a folder to start tracking (Ctrl+N)">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="18" Margin="0,0,14,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Create a new repository" FontWeight="SemiBold"/>
                            <TextBlock Text="Start saving versions of a folder of documents, images or data."
                                       Style="{StaticResource SubtleText}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource StartOption}" Command="{Binding OpenFolderCommand}"
                        ToolTip="Pick a folder Ventrail (or Git) already tracks (Ctrl+O)">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="18" Margin="0,0,14,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Add an existing repository" FontWeight="SemiBold"/>
                            <TextBlock Text="Open a folder you already track to see its changes and history."
                                       Style="{StaticResource SubtleText}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource StartOption}" Command="{Binding NavigateToNetworkCommand}"
                        ToolTip="Download a repository from a computer on the same network">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="18" Margin="0,0,14,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Get a repository from another computer" FontWeight="SemiBold"/>
                            <TextBlock Text="Download a copy from a computer on your network, checked block by block."
                                       Style="{StaticResource SubtleText}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,12,0,0">
                    New to Ventrail? <Hyperlink Command="{Binding OpenUserGuideCommand}" Foreground="{DynamicResource AccentBrush}">Read the user guide</Hyperlink>
                    (F1). Light and dark mode are at the bottom of the sidebar.
                </TextBlock>
            </StackPanel>

            <!-- ===================== Recent ===================== -->
            <DockPanel Grid.Row="1" Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Recent repositories" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                    <Grid>
                        <StackPanel Margin="20,26" HorizontalAlignment="Center"
                                    Visibility="{Binding HasRecentRepositories, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="26" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Folders you open will be listed here." Style="{StaticResource SubtleText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Each recent folder is a row: one click reopens it -->
                        <ItemsControl ItemsSource="{Binding RecentRepositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="16,10"
                                                Foreground="{DynamicResource TextBrush}"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Open this folder">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10"
                                                           Foreground="{DynamicResource SubtleTextBrush}"/>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="16" Margin="0,0,12,0"
                                                           Foreground="{DynamicResource SubtleTextBrush}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Converter={StaticResource FolderName}}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource SubtleText}" FontSize="11.5"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
