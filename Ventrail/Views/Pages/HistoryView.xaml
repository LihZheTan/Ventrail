<UserControl x:Class="Ventrail.Views.Pages.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ventrail.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainDashboardViewModel}"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!-- Version history (DAG) on the left, details of the selected version on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Version list ===================== -->
        <DockPanel Grid.Column="0" Margin="26,22,26,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="History" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,0">
                    <Run Text="{Binding History.Count, Mode=OneWay}"/> saved versions on
                    <Run Text="{Binding BranchName, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <Grid>
                <TextBlock Text="No versions saved yet. Commit some changes to start your history."
                           Style="{StaticResource SubtleText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>

                <!--
                    Visual commit history (Week 4): a vertical line joins the versions like Git's DAG.
                    Newest at the top (glowing node), merges in purple, oldest at the bottom.
                -->
                <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedCommit}"
                         ItemContainerStyle="{StaticResource TimelineItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Line + node -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- line above the node (hidden on the newest version) -->
                                    <Rectangle Grid.Row="0" Width="2" Fill="{StaticResource TimelineBrush}" HorizontalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- line below the node (hidden on the oldest version) -->
                                    <Rectangle Grid.Row="1" Width="2" Fill="{StaticResource TimelineBrush}" HorizontalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOldest}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- the node itself -->
                                    <Ellipse Grid.RowSpan="2" Width="14" Height="14" StrokeThickness="2.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource WindowBrush}"/>
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMerge}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource MergeBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>

                                <!-- Version card -->
                                <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8"
                                        BorderThickness="1" Padding="14,10" Margin="0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Border Style="{StaticResource Pill}" Background="{StaticResource AccentTintBrush}" Margin="0,0,6,0"
                                                    Visibility="{Binding IsLatest, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Latest" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                                    Visibility="{Binding IsMerge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Merge" FontSize="11" Foreground="{StaticResource MergeBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding ShortHash}" FontFamily="Consolas" FontSize="12"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource SubtleText}" FontSize="12" ToolTip="{Binding DisplayTime}">
                                                <Run Text="{Binding Author, Mode=OneWay}"/> ·
                                                <Run Text="{Binding RelativeTime, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- ===================== Version details ===================== -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,22,20,20">
            <Border.Style>
                <!-- Responsive (Week 4): the details pane gets narrower on small windows -->
                <Style TargetType="Border">
                    <Setter Property="Width" Value="330"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthBelow}, ConverterParameter=860}" Value="True">
                            <Setter Property="Width" Value="260"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Version Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock DockPanel.Dock="Top" Text="Select a version on the left to see what it contains."
                           Style="{StaticResource SubtleText}"
                           Visibility="{Binding HasSelectedCommit, Converter={StaticResource InverseBoolToVis}}"/>

                <DockPanel Visibility="{Binding HasSelectedCommit, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedCommit.Message}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0">
                            <Run Text="{Binding SelectedCommit.Author, Mode=OneWay}"/> ·
                            <Run Text="{Binding SelectedCommit.DisplayTime, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedCommit.Hash}" FontFamily="Consolas" FontSize="11"
                                   Style="{StaticResource SubtleText}" Margin="0,6,0,18"/>
                        <TextBlock Text="FILES IN THIS VERSION" Style="{StaticResource PaneTitle}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="Restore Selected File" Style="{StaticResource AccentButton}" Padding="0,9"
                                Command="{Binding RestoreSelectedFileCommand}"
                                ToolTip="Bring this file back exactly as it was in this version"/>
                        <TextBlock Text="Restoring never deletes history. The old file comes back as a new change you can save."
                                   Style="{StaticResource SubtleText}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}"
                             ItemContainerStyle="{StaticResource CompactListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
