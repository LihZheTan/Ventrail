<Window x:Class="Ventrail.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ventrail.ViewModels"
        xmlns:pages="clr-namespace:Ventrail.Views.Pages"
        xmlns:controls="clr-namespace:Ventrail.Views.Controls"
        xmlns:themes="clr-namespace:Ventrail.Themes"
        xmlns:conv="clr-namespace:Ventrail.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainDashboardViewModel}"
        Title="Ventrail" Height="760" Width="1240" MinWidth="760" MinHeight="540"
        Icon="/Assets/Ventrail.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">

    <!--
        App shell, redesigned in the style of GitHub Desktop:
          menu bar (File / View / Repository / Help)
          toolbar: current repository ▾ | current branch | scan for changes | share on network
          the current page (Welcome, Changes/History, Peer-to-peer, Session summary)
          a slim status bar, and the overlays (loading, committing, diff, dialog, toast) on top.
    -->
    <Window.Resources>
        <conv:FolderNameConverter x:Key="FolderName"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateToStagingCommand}"/>
        <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateToHistoryCommand}"/>
        <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateToNetworkCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ShowInExplorerCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenUserGuideCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelDialogCommand}"/>
    </Window.InputBindings>

    <Grid>
    <DockPanel>

        <!-- ===================== Menu bar ===================== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New repository..." InputGestureText="Ctrl+N" Command="{Binding OpenFolderCommand}"/>
                <MenuItem Header="_Add local repository..." InputGestureText="Ctrl+O" Command="{Binding OpenFolderCommand}"/>
                <MenuItem Header="_Get from another computer..." Command="{Binding NavigateToNetworkCommand}"/>
                <Separator/>
                <MenuItem Header="_Recent repositories" ItemsSource="{Binding RecentRepositories}"
                          IsEnabled="{Binding HasRecentRepositories}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ShowSessionSummaryCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Changes" InputGestureText="Ctrl+1" Command="{Binding NavigateToStagingCommand}"
                          IsEnabled="{Binding HasRepo}"/>
                <MenuItem Header="_History" InputGestureText="Ctrl+2" Command="{Binding NavigateToHistoryCommand}"
                          IsEnabled="{Binding HasRepo}"/>
                <MenuItem Header="_Peer-to-peer" InputGestureText="Ctrl+3" Command="{Binding NavigateToNetworkCommand}"/>
                <MenuItem Header="Ho_me" Command="{Binding NavigateToWelcomeCommand}"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem Header="Match _Windows" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static themes:AppTheme.System}"
                              IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static themes:AppTheme.System}}"/>
                    <MenuItem Header="_Light" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static themes:AppTheme.Light}"
                              IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static themes:AppTheme.Light}}"/>
                    <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static themes:AppTheme.Dark}"
                              IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static themes:AppTheme.Dark}}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Repository">
                <MenuItem Header="_Scan for changes" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
                <MenuItem Header="Stage _all" Command="{Binding StageAllCommand}"/>
                <MenuItem Header="Share via _P2P" Command="{Binding ShareRepositoryCommand}"/>
                <Separator/>
                <MenuItem Header="Show in _Explorer" InputGestureText="Ctrl+Shift+F" Command="{Binding ShowInExplorerCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User guide" InputGestureText="F1" Command="{Binding OpenUserGuideCommand}"/>
                <MenuItem Header="_About Ventrail" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ===================== Toolbar ===================== -->
        <Border DockPanel.Dock="Top" Height="54" Background="{DynamicResource ToolbarBrush}">
            <DockPanel>
                <!-- Quick light/dark switch (also View > Theme) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="54" Padding="0"
                        HorizontalContentAlignment="Center" Click="ToggleTheme_Click"
                        ToolTip="Switch between light and dark (View > Theme for more)">
                    <TextBlock x:Name="ThemeIcon" Style="{StaticResource ToolbarIcon}" Margin="0" Text="&#xE793;"/>
                </Button>

                <!-- Current repository ▾ -->
                <ToggleButton x:Name="RepoToggle" Style="{StaticResource ToolbarToggle}" Width="290"
                              ToolTip="{Binding CurrentDirectory}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ToolbarIcon}" FontSize="10" Margin="10,0,0,0"
                                   Text="&#xE70D;"/>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8B7;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Current repository" Style="{StaticResource ToolbarCaption}"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ToolbarValue}">
                                        <Setter Property="Text" Value="{Binding RepoName}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRepo}" Value="False">
                                                <Setter Property="Text" Value="No repository open"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>

                <!-- Current branch -->
                <Button Style="{StaticResource ToolbarButton}" Width="210" Command="{Binding NavigateToHistoryCommand}"
                        IsEnabled="{Binding HasRepo}"
                        ToolTip="Ventrail saves versions on one branch at a time. Click to see its history.">
                    <DockPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8AB;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Current branch" Style="{StaticResource ToolbarCaption}"/>
                            <TextBlock Text="{Binding BranchName, FallbackValue='-', TargetNullValue='-'}" Style="{StaticResource ToolbarValue}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- Scan for changes -->
                <Button Style="{StaticResource ToolbarButton}" Width="210" Command="{Binding RefreshCommand}"
                        ToolTip="Look for files that changed since the last scan (F5)">
                    <DockPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE72C;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Scan for changes" Style="{StaticResource ToolbarValue}"/>
                            <TextBlock Text="{Binding LastScanText}" Style="{StaticResource ToolbarCaption}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- Share on network -->
                <Button Style="{StaticResource ToolbarButton}" Width="210" Command="{Binding NavigateToNetworkCommand}"
                        HorizontalAlignment="Left"
                        ToolTip="Find computers on your network and share versions with them (Ctrl+3)">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource ToolbarHoverBrush}"
                                Visibility="{Binding HasPeers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActivePeers.Count}" FontSize="11" Foreground="{DynamicResource ToolbarTextBrush}"/>
                        </Border>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE72D;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Share on network" Style="{StaticResource ToolbarValue}"/>
                            <TextBlock Text="{Binding NetworkStateText}" Style="{StaticResource ToolbarCaption}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Repository list that drops down from "Current repository" -->
        <Popup IsOpen="{Binding IsChecked, ElementName=RepoToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=RepoToggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="340" Margin="0,0,12,12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="0,0,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Recent repositories" Style="{StaticResource PaneTitle}" Margin="14,12,14,6"/>
                    <TextBlock Text="Folders you open will be listed here." Style="{StaticResource SubtleText}" Margin="14,0,14,8"
                               Visibility="{Binding HasRecentRepositories, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding RecentRepositories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="14,6"
                                        Foreground="{DynamicResource TextBrush}" Click="ClosePopup_Click"
                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Converter={StaticResource FolderName}}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SubtleText}" FontSize="11"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,6,0,0"/>
                    <UniformGrid Columns="2" Margin="10">
                        <Button Content="Add or create..." Margin="0,0,5,0" Click="ClosePopup_Click"
                                Command="{Binding OpenFolderCommand}" ToolTip="Open a folder to track (Ctrl+O)"/>
                        <Button Content="From network..." Margin="5,0,0,0" Click="ClosePopup_Click"
                                Command="{Binding NavigateToNetworkCommand}"
                                ToolTip="Download a repository from another computer"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RailBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SubtleText}" FontSize="11.5"
                           Text="{Binding AppVersion, Mode=OneTime}"/>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="70" Height="3" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtleText}" FontSize="11.5"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Pages (only the current one is visible) ===================== -->
        <Grid>
            <pages:WelcomeView
                Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static vm:AppPage.Welcome}}"/>
            <pages:RepositoryView x:Name="RepositoryPage">
                <pages:RepositoryView.Style>
                    <Style TargetType="pages:RepositoryView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Staging}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.History}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </pages:RepositoryView.Style>
            </pages:RepositoryView>
            <pages:NetworkView
                Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static vm:AppPage.Network}}"/>
            <pages:SummaryView
                Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static vm:AppPage.Summary}}"/>
        </Grid>
    </DockPanel>

    <!-- ===================== Overlays ===================== -->

    <!-- Loading: opening and scanning a folder -->
    <Grid Background="{DynamicResource BackdropBrush}"
          Visibility="{Binding IsLoadingRepository, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,26">
            <StackPanel>
                <controls:Spinner HorizontalAlignment="Center"/>
                <TextBlock Text="Opening folder and scanning files..." Margin="0,16,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Large folders can take a moment." Style="{StaticResource SubtleText}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Commit progress (proposal Fig 3.4) -->
    <Grid Background="{DynamicResource BackdropBrush}"
          Visibility="{Binding IsCommitting, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CommitProgress, StringFormat={}{0:0}%}" FontWeight="SemiBold"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="Committing changes..." Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource GlowProgressBar}" Value="{Binding CommitProgress, Mode=OneWay}"/>
                <TextBlock Text="{Binding CommitProgressText}" Margin="0,12,0,0"/>
                <TextBlock Text="Your files are being saved as a new version. Please don't close Ventrail."
                           Style="{StaticResource SubtleText}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Full-size diff (double-click a file, or "Expand" above the diff); Esc = close -->
    <Grid Background="{DynamicResource BackdropBrush}"
          Visibility="{Binding IsDiffOpen, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource Card}" Background="{DynamicResource WindowBrush}" Margin="40,30" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,14,12,12">
                    <Button DockPanel.Dock="Right" Command="{Binding CloseDiffCommand}" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Top" ToolTip="Close (Esc)">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Changes since the last saved version" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CurrentDiff.FilePath}" Style="{StaticResource MonoText}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentDiff.Summary}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding CurrentDiff.CanShowLines, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}"/>
                <ContentControl Content="{Binding CurrentDiff}" ContentTemplate="{StaticResource DiffTemplate}"/>
            </DockPanel>
        </Border>
    </Grid>

    <!-- Confirm dialog: firewall permission, restore, exit, about (Esc = cancel) -->
    <Grid Background="{DynamicResource BackdropBrush}"
          Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource Card}" Background="{DynamicResource WindowBrush}"
                MaxWidth="480" Margin="24" Padding="24,20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentTintBrush}" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding DialogIcon}" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource SectionTitle}" FontSize="17"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource SubtleText}" FontSize="13.5"
                           LineHeight="20" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding DialogCancelText}" Command="{Binding CancelDialogCommand}"
                            MinWidth="92" Margin="0,0,10,0" IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <!-- Info-only dialogs (About) have no cancel button -->
                                    <DataTrigger Binding="{Binding DialogCancelText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding DialogConfirmText}" Command="{Binding ConfirmDialogCommand}"
                            Style="{StaticResource AccentButton}" MinWidth="92"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Toast notification (bottom-right, hides itself) -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,40"
            MaxWidth="420" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel Margin="14,11,8,11">
            <Button DockPanel.Dock="Right" Command="{Binding DismissToastCommand}" ToolTip="Dismiss"
                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
            </Button>
            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#xE946;"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                                <Setter Property="Text" Value="&#xE930;"/>
                                <Setter Property="Foreground" Value="{DynamicResource AddedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                                <Setter Property="Text" Value="&#xE783;"/>
                                <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
    </Grid>
</Window>
