<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Week 8: offline trainer for Ventrail's heavy/light file classifier.
    Builds a dataset from real files, trains an ML.NET FastTree model, evaluates it and writes
    ../Ventrail/MLModels/ventrail_classifier.zip, which the app ships with. Not part of the app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="4.0.2" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="4.0.2" />
  </ItemGroup>

  <!-- Same feature code as the app, so training and prediction can never disagree. -->
  <ItemGroup>
    <Compile Include="..\Ventrail\Services\AI\FileFeatures.cs" Link="Shared\FileFeatures.cs" />
  </ItemGroup>

</Project>
